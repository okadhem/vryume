#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(push_constant) uniform PushConstant {
    vec3 tile_pos; // in model space
} push_constant;

layout(
    set = 0,
    binding = 0,
    r8
) uniform writeonly image3D tile_image;

//TODO double check
// q normalized quaternion
vec3 rotate_by_quat(vec4 q, vec3 v) {
    vec3 t = 2.0 * cross(q.xyz, v);
    return v + q.w * t + cross(q.xyz, t);
}
vec4 inverse_unit_quat(vec4 q) {
    return vec4(-q.x,-q.y,-q.z,q.w);
}

float sphere_at_origin(vec3 pos, float r) {
    return length(pos) - r;
}

float sdBox( vec3 p, vec3 b )
{
  vec3 q = abs(p) - b;
  return length(max(q,0.0)) + min(max(q.x,max(q.y,q.z)),0.0);
}

float transformed_box(vec3 p, vec4 unit_quat, vec3 translation)
{
    return sdBox(rotate_by_quat(inverse_unit_quat(unit_quat), p - translation), vec3(0.1,0.1,0.1));
}

float sdf_union(float a, float b) {
    return min(a,b);
}


//pos in model space
//returns distance in meters
float model_signed_distance(vec3 pos) {
    float zero = transformed_box(pos, vec4(0.0, 0.0, 0.0, 1.0), vec3(0.05,0.05,0.05));
    float a = transformed_box(pos, vec4(0.0, 0.0, 0.0, 1.0), vec3(0.35,0.05,0.05));
    float b = transformed_box(pos, vec4(0.0, 0.0, 0.0, 1.0), vec3(0.05,0.35,0.05));
    float c = transformed_box(pos, vec4(0.0, 0.0, 0.0, 1.0), vec3(0.05,0.05,0.35));
    float d = transformed_box(pos, vec4(0.0, 0.0, 0.0, 1.0), vec3(0.60,0.05,0.05));
    float e = transformed_box(pos, vec4(0.0, 0.0, 0.0, 1.0), vec3(0.05,0.60,0.05));
    float f = transformed_box(pos, vec4(0.0, 0.0, 0.0, 1.0), vec3(0.05,0.05,0.60));
    return sphere_at_origin(pos, 0.1);
    //return min(min(min(min(min(min(zero,a),b),c),d),e),f);
    //return min(min(min(zero,a),b),c);
}

// Distance between two representable distance values, first representable value is 0 then we add this step to get the next one
// untill we reach max representable value
// it follows that // Maximum error in encoding is encoded_distance_resolution / 2, because we round to the nearest int after the division
const float encoded_distance_resolution = 0.0005; // in m
const float max_representable_distance = 255.0 * encoded_distance_resolution;
// returns a 8 bit unsigned int
//uint encode_distance(float distance) {
//    return uint(clamp(round(distance / encoded_distance_resolution), 0, 255));
//}

float encode_distance(float distance) {
    return clamp(distance / max_representable_distance, 0, 1);
}

const float inter_sample_distance = 0.002; // in m
void main() {
    ivec3 invocation_id = ivec3(gl_GlobalInvocationID.xyz);
    vec3 sample_position = push_constant.tile_pos + invocation_id * inter_sample_distance; // in model space
    float encoded_distance = encode_distance(model_signed_distance(sample_position));
    imageStore(tile_image, invocation_id, vec4(encoded_distance, 0, 0, 0));
}
