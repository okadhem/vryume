void write_first_surface(ivec3 voxel_id, int material_id) {}

void write_second_surface(ivec3 voxel_id, flaot[8] second_surface_sdf, int second_surface_material_id) {
    uint first_surface_material_id = read_1_surface_voxel_material_id(voxel_id);
    float[8] first_surface_sdf = read_1_surface_voxel_sdf(voxel_id);

    uint[3] voxel_mapping;
    float[8][3] voxel_sdf_mapping;
    {
        if (first_surface_material_id < second_surface_material_id) {
            voxel_mapping[0] = first_surface_material_id;
            voxel_sdf_mapping[0] = first_surface_sdf;

            voxel_mapping[1] = second_surface_material_id;
            voxel_sdf_mapping[1] = second_surface_sdf;

            voxel_mapping[2] = UNMAPPED_CHANNEL;
        } else {
            voxel_mapping[0] = second_surface_material_id;
            voxel_sdf_mapping[0] = second_surface_sdf

            voxel_mapping[1] = first_surface_material_id;
            voxel_sdf_mapping[1] = first_surface_sdf;

            voxel_mapping[2] = UNMAPPED_CHANNEL;
        }
    }

    write_two_surface_mapping(voxel_id, voxel_mapping, voxel_sdf_mapping);
}

const MAX_RADIUS = 4 ; // in voxels // TODO find better name

// inner loop for the main write_third_surface function, i needed to break from the nested 3 loops
void write_third_surface_inner_loop(ivec3 v, uint[3] v_prime_mapping, float[8][3] v_prime_mapping_sdf, uint[2] v_materials // material ids sorted in ascending order
) {
    for (int k = -1; k <= 1; ++k)
        for (int j = -1; j <= 1; ++j)
            for (int i = -1; i <= 1; ++i)
            {
                ivec3 offset = ivec3(i, j, k);

                if (offset == ivec3(0))
                    continue;

                uint neighbour_texel = texelFetch(tile_voxel_material, v + offset, 0).r;

                if ((neighbour_texel & HEADER_MASK) == ONE_SURFACE_VOXEL_HEADER) {
                    continue;
                }
                if ((neighbour_texel & HEADER_MASK) == TWO_SURFACE_VOXEL_1_HEADER || (neighbour_texel & HEADER_MASK) == TWO_SURFACE_VOXEL_2_HEADER) {
                    uint[2] neighbour_materials = read_2_surface_voxel_material_id(v + offset);
                    sort2(neighbour_materials);

                    if (neighbour_materials[0] == v_materials[0] && neighbour_materials[1] == v_materials[1]) {
                        // this neighbour is encoding the same two surfaces either with the same mapping as us (one of the L*) or the compatible prime
                        // mapping.
                        continue;
                    }

                    write_two_surface_mapping(v + offset, v_prime_mapping, v_prime_mapping_sdf);
                    return;
                }
                if ((neighbour_texel & HEADER_MASK) == THREE_SURFACE_VOXEL_HEADER) {
                    // TODO maybe check that its our 3 surfaces and assert otherwise
                    write_two_surface_mapping(v + offset, v_prime_mapping, v_prime_mapping_sdf);
                    return;
                }

                // unreachable
            }
}

void write_third_surface(ivec3 target_3_surface_voxel, flaot[8] sdf, int material_id) {
    uint[3] ordered_materials;
    uint[3] ordered_sdfs;
    {
        uint8[2] step_2_materials = read_2_surface_voxel_material_id(target_3_surface_voxel);
        uint[3] ordered_materials = {
                material_id,
                step_2_materials[0],
                step_2_materials[1]
            };

        float[8][2] step_2_sdfs = read_2_surface_voxel_sdfs(target_3_surface_voxel);
        uint[3] ordered_sdfs = {
                sdf,
                step_2_sdfs[0],
                step_2_sdfs[1]
            };
        sort_asc_material_id(ordered_materials, ordered_sdfs);
    }

    imageStore(tile_voxel_material, target_3_surface_voxel, uvec4(THREE_SURFACE_VOXEL_HEADER, 0u, 0u, 0u));

    for (int r = 0; r <= MAX_RADIUS; r++)
    {
        for (int z = -r; z <= r; z++)
            for (int y = -r; y <= r; y++)
                for (int x = -r; x <= r; x++)
                {
                    // only process the outer shell
                    if (max(max(abs(x), abs(y)), abs(z)) != r)
                        continue;

                    ivec3 v = target_3_surface_voxel + ivec3(x, y, z);

                    // TODO: bounds check, i think we might not need code here because we are not at texture boundry, but we need to confirm this
                    uint texel = texelFetch(tile_voxel_material, v, 0).r;
                    if ((texel & HEADER_TWO_SURFACE_CONFIG_MASK) == TWO_SURFACE_VOXEL_C13_CONFIG
                            || (texel & HEADER_TWO_SURFACE_CONFIG_MASK) == TWO_SURFACE_VOXEL_C23_CONFIG
                            || (texel & HEADER_MASK) == THREE_SURFACE_VOXEL_HEADER) {
                        // this should not happen under the geometry assumtion, 3 line intersection are assumed to be far apart enough that we don't see this.
                        // TODO: mark the error somewhere
                        return;
                    }

                    if ((texel & HEADER_MASK) == ONE_SURFACE_VOXEL_HEADER) {
                        continue;
                    }

                    // v is a TWO_SURFACE_VOXEL_C12_CONFIG
                    uint[2] v_materials = read_2_surface_voxel_material_id(v);
                    // assert(v_materials == sort2(v_materials)); // because this is a TWO_SURFACE_VOXEL_C12_CONFIG written by STEP_2_SURFACE, so it is ordered in ascending material_id.

                    uint[3] v_prime_mapping;
                    float[8][3] v_prime_mapping_sdf;
                    if (v_materials[0] == ordered_materials[0] && v_materials[1] == ordered_materials[1]) {
                        // L12
                        v_prime_mapping[0] = ordered_materials[0];
                        v_prime_mapping_sdf[0] = ordered_sdfs[0];

                        v_prime_mapping[1] = UNMAPPED_CHANNEL;

                        v_prime_mapping[2] = ordered_materials[1];
                        v_prime_mapping_sdf[2] = ordered_sdfs[1];
                    } else if (v_materials[0] == ordered_materials[1] && v_materials[1] == ordered_materials[2]) {
                        // L23
                        v_prime_mapping[0] = UNMAPPED_CHANNEL;

                        v_prime_mapping[1] = ordered_materials[2];
                        v_prime_mapping_sdf[1] = ordered_sdfs[2];

                        v_prime_mapping[2] = ordered_materials[1];
                        v_prime_mapping_sdf[2] = ordered_sdfs[1];
                    }
                    else if (v_materials[0] == ordered_materials[0] && v_materials[1] == ordered_materials[2]) {
                        // L13
                        v_prime_mapping[0] = ordered_materials[0];
                        v_prime_mapping_sdf[0] = ordered_sdfs[0];

                        v_prime_mapping[1] = ordered_materials[2];
                        v_prime_mapping_sdf[1] = ordered_sdfs[2];

                        v_prime_mapping[2] = UNMAPPED_CHANNEL;
                    } else {
                        // this should not happen normally, only if geometry assemutions are not correct, most likely we have two three surface voxels close to each other.
                        // TODO report error.
                    }

                    write_third_surface_inner_loop(v, v_prime_mapping, v_prime_mapping_sdf);
                }
    }
}

void main() {
    ivec3 invocation_voxel_id = ivec3(gl_GlobalInvocationID.xyz);
    vec3 invocation_position = push_constant.tile_pos + invocation_voxel_id * inter_sample_distance; // in model space

    int surfaces_written = 0;

    float[8] accumulated_removal;
    for (int i = 0; i < 8; i++) {
        accumulated_removal[i] = MIN_FLOAT;
    }

    for (int edit_id = edit_list_size - 1; edit_id >= 0; edit_id--) {
        Edit edit = edit_list[edit_id];
        float[8] primitive_voxel_sdf = evaluate_primitive_voxel(edit, invocation_position);
        if (edit.is_removal) {
            for (int i = 0; i < 8; i++) {
                accumulated_removal[i] = max(accumulated_removal[i], -primitive_voxel_sdf[i])
            }
            continue;
        }

        float[8] primitive_minus_accumulated;
        for (int i = 0; i < 8; i++) {
            primitive_minus_accumulated[i] = max(accumulated_removal[i], primitive_voxel_sdf[i])
        }
        if (!same_sign(primitive_minus_accumulated)) {
            // we hit a primitive, primitive_minus_accumulated is the sdf.
            switch (step) {
                case STEP_1_SURFACE:
                write_first_surface(invocation_voxel_id, edit.material_id);
                return;
                break;

                case STEP_2_SURFACE:
                if (surfaces_written < 1) {
                    // first surface is assumed written in previous step, we do nothing
                    surfaces_written += 1;
                } else {
                    write_second_surface(invocation_voxel_id, primitive_minus_accumulated, edit.material_id);
                    return;
                }
                break;

                case STEP_3_SURFACE:
                if (surfaces_written < 2) {
                    // first surface and second surfaces are written in previous step, we do nothing
                    surfaces_written += 1;
                } else {
                    write_third_surface(invocation_voxel_id, primitive_minus_accumulated, edit.material_id);
                    return;
                }
            }
        }
        for (int i = 0; i < 8; i++) {
            accumulated_removal[i] = max(accumulated_removal[i], -primitive_voxel_sdf[i])
        }
    }
}
