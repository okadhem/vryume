    //            for (int i = 0; i <= 1; ++i) {
    //                ivec3 offset = ivec3(i, j, k);
    //                uint d = decode_distance(imageLoad(tile_image, invocation_voxel_id + offset).r);
    //                if (d < -encoded_distance_error) {
    //                    negative_distance = true;
    //                } else if (d > encoded_distance_error) {
    //                    positive_distance = true;
    //                } else if (d >= -encoded_distance_error && d <= encoded_distance_error) {
    //                    // we can't know the pre encoding distance sign, so we assume this voxel is intersecting the surface
    //                    // and continue shader invocation
    //                    negative_distance = true;
    //                    positive_distance = true;
    //                }
    //            }
    //    if (!(negative_distance && positive_distance)) {
    //        return;
    //    }
    //}

    uint primitive_hit = 0;

    float[3][8] sdfs;
    uint[3] material_ids;

    float[8] accumulated_removal;
    for (int i = 0; i < 8; i++) {
        accumulated_removal[i] = MIN_FLOAT;
    }

    for (int edit_id = int(edit_list_size - 1); edit_id >= 0; edit_id--) {
        Edit edit = edit_list[edit_id];
        float[8] primitive_voxel_sdf = evaluate_primitive_voxel(edit, invocation_position);
        if (edit.is_removal) {
            for (int i = 0; i < 8; i++) {
                accumulated_removal[i] = max(accumulated_removal[i], -primitive_voxel_sdf[i]);
            }
            continue;
        }

        float[8] primitive_minus_accumulated;
        for (int i = 0; i < 8; i++) {
            //primitive_minus_accumulated[i] = max(accumulated_removal[i], primitive_voxel_sdf[i]);
            //float full_distance = max(accumulated_removal[i], primitive_voxel_sdf[i]);
            //DEBUG(temporary disabling the substraction part)
            float full_distance = primitive_voxel_sdf[i];
            //primitive_minus_accumulated[i] = decode_distance(u8bit_float_to_norm_float(norm_float_to_8bit_float(encode_distance(full_distance))));
            //DEBUG(full precision corners)
            primitive_minus_accumulated[i] = full_distance;
        }
        if (!same_sign(primitive_minus_accumulated)) {
            // we hit a primitive, primitive_minus_accumulated is the sdf.
            for (int i = 0; i < 8; i++) {
                //TODO: make this less
                //sdfs[primitive_hit][i] = decode_distance(u8bit_float_to_norm_float(norm_float_to_8bit_float(encode_distance(primitive_minus_accumulated[i]))));
                sdfs[primitive_hit][i] = primitive_minus_accumulated[i];
            }
            material_ids[primitive_hit] = edit.material_id;
            primitive_hit += 1;
        }
        for (int i = 0; i < 8; i++) {
            accumulated_removal[i] = max(accumulated_removal[i], -primitive_voxel_sdf[i]);
        }
    }

    if (primitive_hit > 3) {
        // TODO handle multi primitive same material

        // should not happen under geometry assumptions
        // error
        imageStore(tile_voxel_material, invocation_voxel_id, uvec4(INVALID_VOXEL, 0u, 0u, 0u));
        return;
    }
    switch (pc.step) {
        case STEP_1_SURFACE:
        if (primitive_hit == 1) {
            write_first_surface(invocation_voxel_id, material_ids[0]);
        }
        break;

        case STEP_2_SURFACE:
        if (primitive_hit == 2) {
            if (material_ids[0] > material_ids[1]) {
                // swap the two material an sdf
                uint t = material_ids[0];
                material_ids[0] = material_ids[1];
                material_ids[1] = t;

                float tmp_sdf[8] = sdfs[0];
                sdfs[0] = sdfs[1];
                sdfs[1] = tmp_sdf;
            }
            write_second_surface(invocation_voxel_id, material_ids, sdfs);
        }
        break;

        case STEP_3_SURFACE:
        if (primitive_hit == 3) {
            sort_asc_material_id(material_ids, sdfs);
            write_third_surface(invocation_voxel_id, material_ids, sdfs);
        }
        break;
    }
}
