#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

#include "types.h.glsl"

layout(push_constant) uniform PushConstant {
    vec3 tile_pos; // in model space
} push_constant;

layout(
set = 0,
binding = 0,
r8
) uniform writeonly image3D tile_image;

layout(set = 0, binding = 1, std140) uniform EditsUniformBuffer {
    uint edit_list_size;
    Edit edit_list[4];
};

#include "common.h.glsl"

//pos in model space
//returns distance in meters
float model_signed_distance(vec3 pos) {
    float accumulated_distance = MAX_FLOAT;
    for (uint edit_id = 0; edit_id < edit_list_size; edit_id++) {
        Edit edit = edit_list[edit_id];
        float primtive_distance = evaluate_primitive(edit, pos);
        if (edit.is_removal) {
            accumulated_distance = max(accumulated_distance, -primtive_distance);
        } else {
            accumulated_distance = min(accumulated_distance, primtive_distance);
        }
    }
    return accumulated_distance;
}

void main() {
    ivec3 invocation_id = ivec3(gl_GlobalInvocationID.xyz);
    vec3 sample_position = push_constant.tile_pos + invocation_id * inter_sample_distance; // in model space
    float encoded_distance = encode_distance(model_signed_distance(sample_position));
    imageStore(tile_image, invocation_id, vec4(encoded_distance, 0, 0, 0));
}
