#version 450
// this shader runs per voxel, we identify a voxel with its low x,y,z corner.

// [NOTE: Wrong sdfs after STEP_2_SURFACE]
// At the end of STEP_2_SURFACE, the voxels close to the 3 surface voxels have wrong tile_voxel_material values, but also garbage sdf values
// because of the concurrent incompatible writes to sample points, precisely, any two neigbouring voxels that belong to different lines (not same material_id pair)
// will have garbage sdf values, therefore, STEP_3_SURFACE must not rely on this sdf values and must override them with the correct ones.
// said another way, neighbouring voxels that don't have equal mappings will have wrong sdf values.

// TODO this layout dimensions are bad, they are too big, but its a hack as it divides the total dispatch_dim
// size of 999 voxel, we need to pick a good size and do bound checks like normal people
layout(local_size_x = 9, local_size_y = 9, local_size_z = 9) in;

#include "types.h.glsl"

const int STEP_1_SURFACE = 0; // when this step is done, all one surface voxels are properly encoded.

const int STEP_2_SURFACE = 1; // when this step is done, *most* of two surface voxels are properly encoded, precisely, all two surface voxels that
// are away from a three voxel surface, (the line portion away from any intersection). other two surface voxel are encoded with *wrong* data
// namely wrong configuration, and invalid sdf values, it is the job of STEP_3_SURFACE to fix that.

const int STEP_3_SURFACE = 2; // when this step is done, all three surface voxels are encoded properly, as well as all the two surface voxels close
// to three surface voxels, left in a wrong state by preious step.

layout(set = 0, binding = 0, std140) uniform EditsUniformBuffer {
    uint edit_list_size;
    Edit edit_list[4];
};

layout(push_constant) uniform PushConstant {
    vec3 tile_pos; // in model space
    int step; // one of STEP_XXX, how many sub surface we should encode in this shader run. each step assumes the steps before are done.
    uint voxel_texture_width; // in number of voxels
    uint voxel_texture_height; // in number of voxels
} pc;

layout(
set = 0,
binding = 1,
r8ui
) uniform uimage3D tile_voxel_material;

layout(
set = 0,
binding = 2
) buffer SDFPackedData {
    coherent uint sdf_texels_packed[]; // packed texels with R4G4_UNORM_PACK8 format, R in higher 4 bits
};

layout(
set = 0,
binding = 3
) uniform sampler3D tile_image;

#include "common.h.glsl"

#include "material_evaluation.h.glsl"

// we represent a voxel, channel to surface mapping with a 3 element uint array, where element 0 is
// the surface mapped to the first channel, etc ..
// if a channel is not mapped, we represent it with UNMAPPED_CHANNEL.
const uint UNMAPPED_CHANNEL = UINT_MAX;

bool are_mappings_compatible(uint[3] mapping1, uint[3] mapping2) {
    for (int i = 0; i < 3; i++) {
        if (mapping1[i] == mapping2[i] || mapping1[i] == UNMAPPED_CHANNEL || mapping2[i] == UNMAPPED_CHANNEL) {
            continue;
        }
        return false;
    }
    return true;
}

bool are_mappings_equal(uint[3] mapping1, uint[3] mapping2) {
    for (int i = 0; i < 3; i++) {
        if (mapping1[i] != mapping2[i]) {
            return false;
        }
    }
    return true;
}

void write_sdf_mapping(ivec3 v, uint[3] voxel_mapping, float[3][8] sdf_mapping) {
    // sdf_texels_packed holds sample points, dimensions are voxels + 1.
    uint width = pc.voxel_texture_width + 1;
    uint height = pc.voxel_texture_height + 1;

    // order of sdf cell corner has to agree with the order in evaluate_primitive_voxel
    // it is the order that sdf_mapping[_] is in
    uint[8] offsets = uint[](
            0, // (0,0,0)
            1, // (1,0,0)
            width, // (0,1,0)
            width + 1, // (1,1,0)
            width * height, // (0,0,1)
            width * height + 1, // (1,0,1)
            width * height + width, // (0,1,1)
            width * height + width + 1 // (1,1,1)
        );
    uint zero_offset_index = v.x + v.y * width + v.z * width * height; // index in texels

    uint[8] current_value;
    for (int i = 0; i < 8; i++) {
        uint sample_buffer_index = zero_offset_index + offsets[i]; // in texels

        // we use atomic writes that require the location to be 4 byte aligned
        uint atomic_word_index = sample_buffer_index / 4;
        uint texel_offset_in_atomic_word = sample_buffer_index % 4;

        // CAS loop
        for (; ; ) {
            uint current_value = atomicAdd(sdf_texels_packed[atomic_word_index], 0);
            uint new_value = current_value;
            if (voxel_mapping[0] != UNMAPPED_CHANNEL) {
                // channel 0 stored in low bits, G channel
                uint distance = norm_float_to_4bit_uint(encode_distance_4bits(sdf_mapping[0][i]));
                uint shift = 8 * texel_offset_in_atomic_word;
                uint mask = 0xF << shift; // 0xF = 0b1111
                new_value = (new_value & ~mask) | (distance << shift);
            }
            if (voxel_mapping[1] != UNMAPPED_CHANNEL) {
                // channel 1 stored in high bits, R channel
                uint distance = norm_float_to_4bit_uint(encode_distance_4bits(sdf_mapping[1][i]));
                uint shift = 8 * texel_offset_in_atomic_word + 4;
                uint mask = 0xF << shift; // 0xF = 0b1111
                new_value = (new_value & ~mask) | (distance << shift);
            }
            // channel 2 is not written to the buffer, it is implied to be the total object sdf.

            uint value_before_write = atomicCompSwap(sdf_texels_packed[atomic_word_index], current_value, new_value);
            if (value_before_write == current_value) {
                break;
            }
        }
    }
}

// calculate the sdf values in a specific order
float[8] evaluate_primitive_voxel(Edit edit, vec3 voxel_corner) {
    float[8] result;
    result[0] = evaluate_primitive(edit, voxel_corner);
    result[1] = evaluate_primitive(edit, voxel_corner + vec3(inter_sample_distance, 0, 0));
    result[2] = evaluate_primitive(edit, voxel_corner + vec3(0, inter_sample_distance, 0));
    result[3] = evaluate_primitive(edit, voxel_corner + vec3(inter_sample_distance, inter_sample_distance, 0));
    result[4] = evaluate_primitive(edit, voxel_corner + vec3(0, 0, inter_sample_distance));
    result[5] = evaluate_primitive(edit, voxel_corner + vec3(inter_sample_distance, 0, inter_sample_distance));
    result[6] = evaluate_primitive(edit, voxel_corner + vec3(0, inter_sample_distance, inter_sample_distance));
    result[7] = evaluate_primitive(edit, voxel_corner + vec3(inter_sample_distance, inter_sample_distance, inter_sample_distance));

    return result;
}

// zero is both negative and positive
bool same_sign(float fs[8]) {
    bool has_positive = false;
    bool has_negative = false;

    for (int i = 0; i < 8; ++i)
    {
        if (fs[i] > 0.0)
            has_positive = true;
        else if (fs[i] < 0.0)
            has_negative = true;
    }

    return !(has_positive && has_negative);
}

// The invariant that must be respected when deciding what surface each channel encodes is that a voxel should always
// agree with its neighbours on the mapping of all the channels: if the neighbour voxel uses the channel, it must
// map it to the same surface we are mapping it to. (the reason is shared sample point have to agree on the same distance value).

// Three surfaces meet in a voxel, forming three lines meeting in a point.
// Each surface has an id (material_id), we sort the ids and get the following triplet (S1,S2,S3)
// each line splits two surfaces, we sort their ids and get the following possibilites
// L12: S1,S2
// L23: S2,S3
// L13: S1,S3
// we call the intersection voxel P.
//
// Each line voxels are initially (at the end of STEP_2_SURFACE) encoded with the channel configuration C12 and lower material_id surface
// on channel 1, basically one of L12, L23 and L13 even though this numbers don't make sense at STEP_2_SURFACE since we only see
// two surfaces there not three.

// Rule:
// - L12/L23/L13 must never be neighbours (no overlapping vertices), all of them use the same two channels
// for different surfaces and thus voxels should not be touching.
// - L12/L23/L13 must not be neighbours to P. technically L13 and P are compatible, but L12 and L23
// are not, and we want an algorithm which will have deterministic results even if we shuffle
// material_id assignment. this is important as the choice of material_id will be probably done prior to any
// topology considerations.

// we prepare a version of each of the line encoding called L12' L23' L13', that has two characteristics:
// - L12' is compatible with L12. (resp. L23' and L13')
// - L12' L23' L13' are all compatible with each other and compatible with the 3 surface voxel where they all meet.
// to do that we assign these surfaces to the channels:
// channel 1 => S1, channel 2 => S3, channel 3 => S2, and therefore
// P: channel 1 => S1, channel 2 => S3, channel 3 => S2
// L12': channel 1 => S1, channel 3 => S2
// L23': channel 2 => S3, channel 3 => S2
// L13': channel 1 => S1, channel 2 => S3

// we add an extra rule:
// - L*' should not be neighbouring any L* voxel other than the one naturally associated to it,
// so L12 with L12' is fine but L12 with L13' or L23' is not. technically speaking not all such
// combinations are uncompatible, however for the same reason as above, we refrain from relying on that
// because it would make the algorithm decision depend on an arbitrary material_id assignment.
// a consequence of this is that we will automatically handle the issue expressed in [NOTE: Wrong sdfs after STEP_2_SURFACE]:
// since after STEP_3_SURFACE, we will only allow strict compatibility between neighbouring 2 surface voxels, we are sure that any voxel pair
// is either made of equal mappings, or prime version of one another, which originated from equal mappings in STEP_2_SURFACE
// thus these mappings have correct sdf values.

// The general idea of the algorithm is simply, look at the neighbouring (2surface) voxels to P, up to max radius.
// if the voxel v has incompatible neighbours, meaning it is close to either P, other L* voxels
// or to a L*' that is not its compatible prime form, we switch v to its compatible prime form (L12', L13' or L13').

// TODO: we need to find a way to assert if we write a sample with different surfaces distance values.

// sort in assending material order, both the material_id array and the sdfs array.
void sort_asc_material_id(inout uint material_id[3], inout float sdfs[3][8])
{
    if (material_id[0] > material_id[1]) {
        uint t = material_id[0];
        material_id[0] = material_id[1];
        material_id[1] = t;

        float tmp_sdf[8] = sdfs[0];
        sdfs[0] = sdfs[1];
        sdfs[1] = tmp_sdf;
    }
    if (material_id[1] > material_id[2]) {
        uint t = material_id[1];
        material_id[1] = material_id[2];
        material_id[2] = t;

        float[8] tmp_sdf = sdfs[1];
        sdfs[1] = sdfs[2];
        sdfs[2] = tmp_sdf;
    }
    if (material_id[0] > material_id[1]) {
        uint t = material_id[0];
        material_id[0] = material_id[1];
        material_id[1] = t;

        float[8] tmp_sdf = sdfs[0];
        sdfs[0] = sdfs[1];
        sdfs[1] = tmp_sdf;
    }
}

// we will call cannocial voxel mappings the kind of mappings found at the end of STEP_2_SURFACE (L*) and STEP_3_SURFACE L* and L'*
// so mapping in C12 with ordered material ids and their corresponding prime forms.
// given 2 such voxels, we define the strict compatibility realtion as following
// two voxels mappings are strictly compatible if they are equal.
// two voxels mappings are strictly compatible if one is a STEP_2_SURFACE 2 voxel mapping and the other its prime form.
// strict compatibility implies compatibility.
// in order to test that two cannocial 2 surface voxel are strictly compatible, we can simply check that they map to the same
// surfaces.

// sort in assending order.
void sort2(uint[2] a) {
    if (a[0] > a[1]) {
        uint t = a[0];
        a[0] = a[1];
        a[1] = t;
    }
}

// a voxel mapping, channel to material_id map plus the corresponding singed distance fields.
void write_two_surface_mapping(ivec3 v, uint[3] voxel_mapping, float[3][8] sdf) {
    bool low_channel_surface_done = false;
    bool high_channel_surface_done = false;

    uint low_channel;
    uint high_channel;
    uint v_two_surface_config;
    {
        if (voxel_mapping[0] == UNMAPPED_CHANNEL) {
            v_two_surface_config = TWO_SURFACE_VOXEL_C23_CONFIG;
            low_channel = 1;
            high_channel = 2;
        } else if (voxel_mapping[1] == UNMAPPED_CHANNEL) {
            v_two_surface_config = TWO_SURFACE_VOXEL_C13_CONFIG;
            low_channel = 0;
            high_channel = 2;
        } else if (voxel_mapping[2] == UNMAPPED_CHANNEL) {
            v_two_surface_config = TWO_SURFACE_VOXEL_C12_CONFIG;
            low_channel = 0;
            high_channel = 1;
        } else {
            // error
            imageStore(tile_voxel_material, v, uvec4(INVALID_VOXEL, 0u, 0u, 0u));
        }
    }

    for (int k = -1; k <= 1; ++k)
        for (int j = -1; j <= 1; ++j)
            for (int i = -1; i <= 1; ++i) {
                ivec3 offset = ivec3(i, j, k);

                if (offset == ivec3(0))
                    continue;

                uint neighbour_texel = imageLoad(tile_voxel_material, v + offset).r;

                if ((neighbour_texel & HEADER_MASK) == ONE_SURFACE_VOXEL_HEADER) {
                    uint neighbour_material_id = neighbour_texel & ~HEADER_MASK;

                    if (neighbour_material_id == voxel_mapping[low_channel] && !low_channel_surface_done) {
                        uint neighbour_id = coord_to_neighbour_id(offset);
                        imageStore(tile_voxel_material, v, uvec4(v_two_surface_config | neighbour_id, 0u, 0u, 0u));
                        write_sdf_mapping(v, voxel_mapping, sdf);
                        low_channel_surface_done = true;
                    }

                    if (neighbour_material_id == voxel_mapping[high_channel]) {
                        high_channel_surface_done = true;
                    }

                    if (neighbour_material_id != voxel_mapping[low_channel] && neighbour_material_id != voxel_mapping[high_channel]) {
                        // this should not happen v must be neighbouring only the two surfaces we are mapping, not any other.
                        // error
                        imageStore(tile_voxel_material, v, uvec4(INVALID_VOXEL, 0u, 0u, 0u));
                    }
                }
            }
    if (!low_channel_surface_done || !high_channel_surface_done) {
        // this should never happen, v must be neighbouring the two surfaces we are mapping
        // error
        imageStore(tile_voxel_material, v, uvec4(INVALID_VOXEL, 0u, 0u, 0u));
    }
}

void write_first_surface(ivec3 voxel_id, uint material_id) {
    uint data = ONE_SURFACE_VOXEL_HEADER | (material_id & (~HEADER_MASK));
    imageStore(tile_voxel_material, voxel_id, uvec4(data, 0u, 0u, 0u));
}

void write_second_surface(ivec3 voxel_id, uint[3] ordered_materials, float[3][8] ordered_sdfs) {
    uint[3] voxel_mapping;
    float[3][8] voxel_sdf_mapping;

    voxel_mapping[0] = ordered_materials[0];
    voxel_sdf_mapping[0] = ordered_sdfs[0];

    voxel_mapping[1] = ordered_materials[1];
    voxel_sdf_mapping[1] = ordered_sdfs[1];

    voxel_mapping[2] = UNMAPPED_CHANNEL;

    write_two_surface_mapping(voxel_id, voxel_mapping, voxel_sdf_mapping);
}

const int MAX_RADIUS = 4; // in voxels // TODO find better name

// inner loop for the main write_third_surface function, i needed to be able to break from the nested 3 loops
void write_third_surface_inner_loop(ivec3 v, uint v_prime_mapping[3], float v_prime_mapping_sdf[3][8], uint v_materials[2] // material ids sorted in ascending order
) {
    for (int k = -1; k <= 1; ++k)
        for (int j = -1; j <= 1; ++j)
            for (int i = -1; i <= 1; ++i)
            {
                ivec3 offset = ivec3(i, j, k);

                if (offset == ivec3(0))
                    continue;

                uint neighbour_texel = imageLoad(tile_voxel_material, v + offset).r;

                if ((neighbour_texel & HEADER_MASK) == ONE_SURFACE_VOXEL_HEADER) {
                    continue;
                }
                if ((neighbour_texel & HEADER_MASK) == TWO_SURFACE_VOXEL_1_HEADER || (neighbour_texel & HEADER_TWO_SURFACE_CONFIG_MASK) == TWO_SURFACE_VOXEL_C23_CONFIG) {
                    uint[2] neighbour_materials = read_2_surface_voxel_material_id(v + offset);
                    sort2(neighbour_materials);

                    if (neighbour_materials[0] == v_materials[0] && neighbour_materials[1] == v_materials[1]) {
                        // both us and this neighbour are cannocial voxels, with same material ids, therefore we are
                        // strictly compatible.
                        continue;
                    }

                    write_two_surface_mapping(v + offset, v_prime_mapping, v_prime_mapping_sdf);
                    return;
                }
                if ((neighbour_texel & HEADER_MASK) == THREE_SURFACE_VOXEL_HEADER) {
                    // TODO maybe check that its our 3 surfaces and assert otherwise
                    write_two_surface_mapping(v + offset, v_prime_mapping, v_prime_mapping_sdf);
                    return;
                }

                // unreachable
            }
}

// ordered_materials: materials ids in ascending material id order.
// ordered_sdfs: sdfs in ascending material id order.
void write_third_surface(ivec3 target_3_surface_voxel, uint[3] ordered_materials, float[3][8] ordered_sdfs) {
    imageStore(tile_voxel_material, target_3_surface_voxel, uvec4(THREE_SURFACE_VOXEL_HEADER, 0u, 0u, 0u));
    {
        uint[3] voxel_mapping = uint[3](ordered_materials[0], ordered_materials[2], ordered_materials[1]);
        float[3][8] voxel_sdfs = float[3][8](ordered_sdfs[0], ordered_sdfs[2], ordered_sdfs[1]);
        write_sdf_mapping(target_3_surface_voxel, voxel_mapping, voxel_sdfs);
    }

    for (int r = 0; r <= MAX_RADIUS; r++)
    {
        for (int z = -r; z <= r; z++)
            for (int y = -r; y <= r; y++)
                for (int x = -r; x <= r; x++)
                {
                    // only process the outer shell
                    if (max(max(abs(x), abs(y)), abs(z)) != r)
                        continue;

                    ivec3 v = target_3_surface_voxel + ivec3(x, y, z);

                    // TODO: bounds check, i think we might not need code here because we are not at texture boundry, but we need to confirm this
                    uint texel = imageLoad(tile_voxel_material, v).r;
                    if ((texel & HEADER_TWO_SURFACE_CONFIG_MASK) == TWO_SURFACE_VOXEL_C13_CONFIG
                            || (texel & HEADER_TWO_SURFACE_CONFIG_MASK) == TWO_SURFACE_VOXEL_C23_CONFIG
                            || (texel & HEADER_MASK) == THREE_SURFACE_VOXEL_HEADER) {
                        // this should not happen under the geometry assumtion, 3 line intersection are assumed to be far apart enough that we don't see this.
                        // error
                        imageStore(tile_voxel_material, target_3_surface_voxel, uvec4(INVALID_VOXEL, 0u, 0u, 0u));
                        return;
                    }

                    if ((texel & HEADER_MASK) == ONE_SURFACE_VOXEL_HEADER) {
                        continue;
                    }

                    // v is a TWO_SURFACE_VOXEL_C12_CONFIG
                    uint[2] v_materials = read_2_surface_voxel_material_id(v);
                    // assert(v_materials == sort2(v_materials)); // because this is a TWO_SURFACE_VOXEL_C12_CONFIG written by STEP_2_SURFACE, so it is ordered in ascending material_id.

                    uint[3] v_prime_mapping;
                    float[3][8] v_prime_mapping_sdf;
                    if (v_materials[0] == ordered_materials[0] && v_materials[1] == ordered_materials[1]) {
                        // L12
                        v_prime_mapping[0] = ordered_materials[0];
                        v_prime_mapping_sdf[0] = ordered_sdfs[0];

                        v_prime_mapping[1] = UNMAPPED_CHANNEL;

                        v_prime_mapping[2] = ordered_materials[1];
                        v_prime_mapping_sdf[2] = ordered_sdfs[1];
                    } else if (v_materials[0] == ordered_materials[1] && v_materials[1] == ordered_materials[2]) {
                        // L23
                        v_prime_mapping[0] = UNMAPPED_CHANNEL;

                        v_prime_mapping[1] = ordered_materials[2];
                        v_prime_mapping_sdf[1] = ordered_sdfs[2];

                        v_prime_mapping[2] = ordered_materials[1];
                        v_prime_mapping_sdf[2] = ordered_sdfs[1];
                    }
                    else if (v_materials[0] == ordered_materials[0] && v_materials[1] == ordered_materials[2]) {
                        // L13
                        v_prime_mapping[0] = ordered_materials[0];
                        v_prime_mapping_sdf[0] = ordered_sdfs[0];

                        v_prime_mapping[1] = ordered_materials[2];
                        v_prime_mapping_sdf[1] = ordered_sdfs[2];

                        v_prime_mapping[2] = UNMAPPED_CHANNEL;
                    } else {
                        // this should not happen normally, only if geometry assemutions are not correct, most likely we have two three surface voxels close to each other.
                        // error
                        imageStore(tile_voxel_material, target_3_surface_voxel, uvec4(INVALID_VOXEL, 0u, 0u, 0u));
                    }

                    write_third_surface_inner_loop(v, v_prime_mapping, v_prime_mapping_sdf, v_materials);
                }
    }
}

void main() {
    //TODO: we should handle multi primitive same material here, i am thinking just union the surfaces of material, but i am still not sure.

    ivec3 invocation_voxel_id = ivec3(gl_GlobalInvocationID.xyz);
    //vec3 invocation_position = pc.tile_pos + invocation_voxel_id * inter_sample_distance; // in model space

    //DEBUG(pixel center)
    vec3 invocation_position = pc.tile_pos + 0.5 * vec3(inter_sample_distance) + invocation_voxel_id * inter_sample_distance; // in model space

    // initialize the all the voxel info before doing any work in step 1 or any of the following steps
    // or the algorithm could read garbage data. probably done better with a clear command.
    if (pc.step == STEP_1_SURFACE) {
        imageStore(tile_voxel_material, invocation_voxel_id, uvec4(NULL_VOXEL, 0u, 0u, 0u));
    }

    // we should probably early exit if we the voxel is not near the surface for performance reasons
    // something like the block bellow:
